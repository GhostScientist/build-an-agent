{
  "name": "researcher-agent",
  "version": "1.0.0",
  "description": "Test researcher agent with knowledge tools",
  "main": "dist/cli.js",
  "bin": {
    "researcher-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "node dist/cli.js --help",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ai-agent",
    "cli",
    "openai",
    "automation",
    "knowledge",
    "assistant"
  ],
  "author": "Test User",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.6.2",
    "ora": "^8.2.0",
    "inquirer": "^9.3.8",
    "inquirer-autocomplete-prompt": "^3.0.1",
    "dotenv": "^16.6.1",
    "glob": "^10.5.0",
    "@openai/agents": "^0.18.0",
    "zod": "^4.6.5",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "better-sqlite3": "^12.11.1",
    "pdf-parse": "^1.1.4",
    "mammoth": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/inquirer": "^9.0.10",
    "@types/pdf-parse": "^1.1.5",
    "typescript": "^5.9.3"
  }
}