{
  "name": "agent-workshop-app",
  "version": "0.1.0",
  "description": "Build an Agent Workshop - From Idea to Agent in Minutes",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts e2e",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:generator": "tsx scripts/generator-smoke.ts",
    "test:generator:all": "tsx scripts/generator-matrix.ts",
    "test:generator:build": "tsx scripts/test-build.ts",
    "test:agents": "tsx scripts/test-agents/runner.ts",
    "test:agents:claude": "tsx scripts/test-agents/runner.ts --provider claude",
    "test:agents:openai": "tsx scripts/test-agents/runner.ts --provider openai",
    "test:agents:copilot": "tsx scripts/test-agents/runner.ts --provider copilot",
    "test:agents:quick": "tsx scripts/test-agents/runner.ts --quick",
    "generate:agents": "tsx scripts/generate-all-agents.ts",
    "generate:agents:claude": "tsx scripts/generate-all-agents.ts --provider claude",
    "generate:agents:openai": "tsx scripts/generate-all-agents.ts --provider openai",
    "generate:agents:copilot": "tsx scripts/generate-all-agents.ts --provider copilot"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.19",
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^10.18.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.293.0",
    "monaco-editor": "^0.45.0",
    "next": "15.5.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.1",
    "react-syntax-highlighter": "^16.1.1",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "ai-agents",
    "claude",
    "openai",
    "agent-builder",
    "no-code",
    "automation"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
